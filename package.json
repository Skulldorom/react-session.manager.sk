{
  "name": "react-session.manager.sk",
  "version": "4.0.3",
  "description": "A react component used to manage token sessions with flask backend",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "test": "jest",
    "test:general": "jest --runInBand --testPathIgnorePatterns=/tests/smoke/",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:consumer-smoke": "node scripts/consumer-smoke-test.cjs",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write src/**/*.{js,jsx,css}",
    "preversion": "npm run lint && npm run test:general && npm run build && npm run test:smoke && npm run test:consumer-smoke",
    "postversion": "node -e \"console.log('Version updated to ' + require('./package.json').version)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skulldorom/react-session.manager.sk.git"
  },
  "bugs": {
    "url": "https://github.com/Skulldorom/react-session.manager.sk/issues"
  },
  "homepage": "https://github.com/Skulldorom/react-session.manager.sk#readme",
  "author": "Skulldorom",
  "license": "ISC",
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.2.0"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "react-toastify": "^11.1.0"
  }
}
