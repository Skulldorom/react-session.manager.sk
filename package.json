{
  "name": "react-session.manager.sk",
  "version": "3.1.1",
  "description": "A react component used to manage token sessions with flask backend",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write src/**/*.{js,jsx,css}",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release:patch": "npm run version:patch && git push --follow-tags",
    "release:minor": "npm run version:minor && git push --follow-tags",
    "release:major": "npm run version:major && git push --follow-tags",
    "preversion": "npm run build && npm test --if-present",
    "postversion": "node -e \"console.log('Version updated to ' + require('./package.json').version)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skulldorom/react-session.manager.sk.git"
  },
  "bugs": {
    "url": "https://github.com/Skulldorom/react-session.manager.sk/issues"
  },
  "homepage": "https://github.com/Skulldorom/react-session.manager.sk#readme",
  "author": "Skulldorom",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "react-toastify": "^11.1.0"
  }
}
